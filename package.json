{
  "name": "yt-desktop",
  "version": "2.1.0",
  "description": "YouTube + YouTube Music unified desktop app with ad-block, background playback, PiP, sleep timer, sponsor skip",
  "author": "shivamkumarmehta64-sketch",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build-linux-appimage": "electron-builder -l --config.linux.target=AppImage",
    "build-linux-deb": "electron-builder -l --config.linux.target=deb"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "icon": "icons/icon.ico",
    "files": ["**/*", "!dist", "!node_modules"],
    "win": {
      "target": ["nsis", "portable"],
      "sign": false,
      "legalTrademarks": "mtube",
      "companyName": "Shivam Mehta",
      "fileDescription": "mtube — Lightweight Ad-Free YouTube Music Client"
    },
    "portable": {
      "artifactName": "YT-Desktop-${version}-portable.${ext}"
    },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" },
    "extraResources": []
  }
}

