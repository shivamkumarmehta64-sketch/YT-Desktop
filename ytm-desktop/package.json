{
  "name": "yt-music",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.youtube.music",
    "productName": "YouTube Music",
    "win": { "target": ["portable"], "sign": false },
    "extraResources": [{ "from": "../ublock/uBlock0.chromium", "to": "ublock" }]
  }
}
